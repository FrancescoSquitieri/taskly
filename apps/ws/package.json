{
  "name": "@taskly/ws",
  "version": "0.0.0",
  "private": true,
  "description": "Taskly WebSocket server — Socket.IO + Redis adapter (separate process)",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@repo/constants": "*",
    "@repo/schemas": "*",
    "@repo/types": "*",
    "@socket.io/redis-adapter": "8.3.0",
    "connect-redis": "8.0.1",
    "cookie": "1.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express-session": "1.18.1",
    "ioredis": "5.4.2",
    "pino": "9.6.0",
    "socket.io": "4.8.1",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@repo/config": "*",
    "@types/cookie-parser": "1.4.8",
    "@types/express-session": "1.18.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "jest": "29.7.0",
    "socket.io-client": "4.8.1",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  }
}
