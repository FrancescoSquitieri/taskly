{
  "name": "@taskly/api",
  "version": "0.0.0",
  "private": true,
  "description": "Taskly REST API — Express + Prisma + Redis + BullMQ",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "worker:dev": "tsx watch src/jobs/index.ts",
    "worker:start": "tsx src/jobs/index.ts",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@repo/constants": "*",
    "@repo/schemas": "*",
    "@repo/types": "*",
    "@repo/utils": "*",
    "bcrypt": "5.1.1",
    "bullmq": "5.34.5",
    "compression": "1.7.5",
    "connect-redis": "8.0.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "nodemailer": "6.9.16",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "rate-limit-redis": "4.2.0",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@repo/config": "*",
    "@types/bcrypt": "5.0.2",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/express-session": "1.18.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "jest": "29.7.0",
    "prisma": "6.1.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  }
}
