{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared shadcn/ui component library — Tailwind CSS based",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "ui:add": "shadcn@latest add"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.471.1",
    "sonner": "1.7.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@repo/config": "*",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "shadcn": "2.1.8",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  }
}
