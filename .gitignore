# Dependencies
node_modules
.pnp
.pnp.js

# Environment files at the monorepo root.
# Only `.env.sample` is tracked; everything else (legacy `.env.docker.example`,
# per-env files, local overrides) stays out of git.
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.test
.env.test.local
.env.docker.example

# Per-app legacy env files (superseded by the root .env.<env>).
apps/*/.env
apps/*/.env.*

# Testing
coverage
playwright-report
test-results
.nyc_output

# Turbo
.turbo

# Vercel
.vercel

# Build outputs
.next/
out/
build
dist

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log

# OS / Editor
.DS_Store
*.pem
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local settings (per-user, not project-wide)
.claude/settings.local.json

# Prisma
*.db
*.db-journal

# Docker
.docker/data
