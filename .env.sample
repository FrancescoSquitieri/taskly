# ─────────────────────────────────────────────────────────────────────────────
# Taskly — environment template (tracked in git).
#
# Copy this file to:
#   • .env.development  → host dev (npm run dev)
#   • .env.production   → docker production stack (npm run docker:up)
#   • .env.staging      → docker staging stack
#
# None of those copies are tracked. Replace every PLACEHOLDER_* value with
# real settings before booting the affected environment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Common ──────────────────────────────────────────────────────────────────
# `development` | `production` | `test`. Drives both the API loader (which
# picks the .env.<NODE_ENV> file at the monorepo root) and Express middleware
# behaviour (cookie `secure`, helmet, etc.).
NODE_ENV=development

# Public origin of the web client (used for CORS allow-list + session cookies).
WEB_ORIGIN=http://localhost:5173

# ─── apps/api ────────────────────────────────────────────────────────────────
# REST HTTP port.
API_PORT=4000

# Postgres connection string used by Prisma (`apps/api/prisma/schema.prisma`).
DATABASE_URL=postgresql://taskly:taskly@localhost:5432/taskly?schema=public

# Redis connection (sessions, BullMQ queues, rate limits, presence).
REDIS_URL=redis://localhost:6379

# Session signing secret. MUST be at least 32 characters in any environment.
# Generate one with `openssl rand -hex 32`.
SESSION_SECRET=PLACEHOLDER_session_secret_must_be_at_least_32_characters_long

# Session lifetime in seconds (default: 7 days).
SESSION_TTL_SECONDS=604800

# SMTP — local dev points at Mailhog (`docker-compose.infra.yml`). For real
# environments fill in your provider's credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@taskly.local

# ─── apps/ws ─────────────────────────────────────────────────────────────────
# WebSocket server port.
WS_PORT=4001

# `true` only when more than one ws node is running (uses @socket.io/redis-adapter).
USE_SOCKET_REDIS_ADAPTER=false

# ─── apps/web (Vite — vars MUST be prefixed VITE_ to be exposed to the SPA) ──
# Public URL of the REST API as seen by the browser.
VITE_API_URL=http://localhost:4000

# Public URL of the WebSocket server as seen by the browser.
VITE_WS_URL=http://localhost:4001

# Optional: override the dev server port (default 5173).
VITE_DEV_PORT=5173
